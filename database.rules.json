// REZO Firebase Realtime Database security rules.
// Deploy with:  npx firebase-tools deploy --only database   (or paste into the Rules tab of the RTDB console).
// REZO is end-to-end encrypted, so the database only ever holds ciphertext. These rules add defense in depth: they block reading the whole /rooms or /vaults tree (no enumeration/dumping), only permit access to a specific room or vault whose unguessable id you already know, and reject any field REZO does not write. Room ids carry 80 bits of entropy; vault ids 80 bits.
{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^REZO-[A-F0-9]{20}$/)",
        ".write": "$room.matches(/^REZO-[A-F0-9]{20}$/)",
        "lastActivity": { ".validate": "newData.isNumber()" },
        "ttl": { ".validate": "newData.isNumber()" },
        "messages": {
          "$msg": {
            ".validate": "newData.hasChildren(['ct', 'timestamp'])",
            "ct": { ".validate": "newData.isString() && newData.val().length < 20000" },
            "timestamp": { ".validate": "newData.isNumber()" }
          }
        },
        "presence": {
          "$uid": {
            ".validate": "newData.hasChildren(['ct', 'lastSeen'])",
            "ct": { ".validate": "newData.isString() && newData.val().length < 2000" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "vaults": {
      "$vault": {
        ".read": "$vault.matches(/^V-[A-F0-9]{20}$/)",
        ".write": "$vault.matches(/^V-[A-F0-9]{20}$/)",
        "items": {
          "$item": {
            ".validate": "newData.hasChildren(['ct', 'timestamp'])",
            "ct": { ".validate": "newData.isString() && newData.val().length < 100000" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
