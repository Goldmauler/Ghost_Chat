{
  "name": "rezo",
  "displayName": "REZO",
  "description": "End-to-end encrypted team chat that hides in your editor — a disguised terminal, native review threads, no sidebar, no panels.",
  "version": "3.1.0",
  "publisher": "rezo-vkay-dev",
  "icon": "images/rezo-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Goldmauler/Ghost_Chat.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "team",
    "chat",
    "collaboration",
    "messaging",
    "review",
    "comments",
    "firebase"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rezo.createRoom",
        "title": "REZO: Create New Room"
      },
      {
        "command": "rezo.joinRoom",
        "title": "REZO: Join Room by Invite"
      },
      {
        "command": "rezo.leaveRoom",
        "title": "REZO: Leave Current Room"
      },
      {
        "command": "rezo.openChat",
        "title": "REZO: Open Chat"
      },
      {
        "command": "rezo.copyInvite",
        "title": "REZO: Copy Room Invite"
      },
      {
        "command": "rezo.panic",
        "title": "REZO: Panic (Hide Everything)"
      },
      {
        "command": "rezo.pinSelection",
        "title": "REZO: Pin Selection to Thread"
      },
      {
        "command": "rezo.refreshThreads",
        "title": "REZO: Refresh Threads"
      },
      {
        "command": "rezo.setDisplayName",
        "title": "REZO: Set Display Name"
      },
      {
        "command": "rezo.askAI",
        "title": "REZO: Ask AI"
      },
      {
        "command": "rezo.setAIKeys",
        "title": "REZO: Set AI Keys (Gemini / DeepSeek / Groq)"
      },
      {
        "command": "rezo.saveToVault",
        "title": "REZO: Save to Vault"
      },
      {
        "command": "rezo.openVault",
        "title": "REZO: Open Vault"
      },
      {
        "command": "rezo.showSlashCommands",
        "title": "REZO: Show AI Slash Commands"
      },
      {
        "command": "rezo.replyThread",
        "title": "REZO: Reply"
      },
      {
        "command": "rezo.showChatHistory",
        "title": "REZO: Show Chat History"
      },
      {
        "command": "rezo.showWelcome",
        "title": "REZO: Getting Started"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rezo.replyThread",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "rezo.replyThread",
          "group": "inline",
          "when": "commentController == rezo"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rezo.openChat",
        "key": "ctrl+alt+;",
        "mac": "cmd+alt+;"
      },
      {
        "command": "rezo.panic",
        "key": "ctrl+alt+h",
        "mac": "ctrl+alt+h"
      },
      {
        "command": "rezo.pinSelection",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "rezo.askAI",
        "key": "ctrl+shift+q",
        "mac": "ctrl+shift+q",
        "when": "editorTextFocus"
      },
      {
        "command": "rezo.saveToVault",
        "key": "ctrl+alt+shift+v",
        "mac": "cmd+alt+shift+v",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "rezo.openVault",
        "key": "ctrl+alt+shift+v",
        "mac": "cmd+alt+shift+v",
        "when": "!editorTextFocus || !editorHasSelection"
      },
      {
        "command": "rezo.showChatHistory",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r"
      }
    ],
    "configuration": {
      "title": "REZO",
      "properties": {
        "rezo.chatDisguise": {
          "type": "string",
          "enum": [
            "node",
            "bash",
            "zsh",
            "python",
            "powershell"
          ],
          "default": "node",
          "markdownDescription": "What the chat terminal is disguised as. The terminal tab name and prompt mimic this shell/REPL so the chat blends into normal terminal work."
        },
        "rezo.notify": {
          "type": "string",
          "enum": [
            "silent",
            "toast"
          ],
          "default": "toast",
          "markdownDescription": "How new messages are announced. `toast` (default) pops a short notification. `silent` shows only the status-bar unread count and the chat terminal — best for staying discreet."
        },
        "rezo.roomExpiry": {
          "type": "string",
          "enum": [
            "5m",
            "35m",
            "1h",
            "4h",
            "24h",
            "7d",
            "never"
          ],
          "default": "24h",
          "markdownDescription": "How long a room stays alive after its last activity. `never` keeps it forever (use with care — Firebase storage is shared)."
        },
        "rezo.firebaseConfig": {
          "type": "object",
          "description": "Optional: override the built-in Firebase backend with your own project.",
          "properties": {
            "apiKey": {
              "type": "string"
            },
            "authDomain": {
              "type": "string"
            },
            "databaseURL": {
              "type": "string"
            },
            "projectId": {
              "type": "string"
            },
            "storageBucket": {
              "type": "string"
            },
            "messagingSenderId": {
              "type": "string"
            },
            "appId": {
              "type": "string"
            }
          },
          "default": {}
        },
        "rezo.geminiApiKey": {
          "type": "string",
          "description": "Gemini API key. Get free at https://aistudio.google.com/apikey. Prefer 'REZO: Set AI Keys' command (secure storage).",
          "default": ""
        },
        "rezo.deepseekApiKey": {
          "type": "string",
          "description": "DeepSeek API key (fallback if Gemini rate limited). Get free at https://platform.deepseek.com.",
          "default": ""
        },
        "rezo.groqApiKey": {
          "type": "string",
          "description": "Groq API key (fallback if DeepSeek rate limited). Get free at https://console.groq.com/keys.",
          "default": ""
        },
        "rezo.geminiModel": {
          "type": "string",
          "default": "gemini-flash-latest",
          "description": "Gemini model id for Ask AI. The default alias always points at Google's current Flash model."
        },
        "rezo.deepseekModel": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "DeepSeek model id for Ask AI."
        },
        "rezo.groqModel": {
          "type": "string",
          "default": "llama-3.1-8b-instant",
          "description": "Groq model id for Ask AI. Change this if Groq retires the default (see console.groq.com/docs/models)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "rezo.getStarted",
        "title": "Get started with REZO",
        "description": "Encrypted chat with your team, without leaving the editor. Four steps, about a minute.",
        "steps": [
          {
            "id": "createOrJoin",
            "title": "1. Create or join a room",
            "description": "A room is a private, end-to-end encrypted channel. Create one, or paste an invite a teammate sent you.\n[Create Room](command:rezo.createRoom)\n[Join with Invite](command:rezo.joinRoom)",
            "media": {
              "markdown": "media/walkthrough/room.md"
            },
            "completionEvents": [
              "onCommand:rezo.createRoom",
              "onCommand:rezo.joinRoom"
            ]
          },
          {
            "id": "invite",
            "title": "2. Share the invite",
            "description": "Copy the invite and send it privately — it holds the decryption key, so treat it like a password.\n[Copy Invite](command:rezo.copyInvite)",
            "media": {
              "markdown": "media/walkthrough/invite.md"
            },
            "completionEvents": [
              "onCommand:rezo.copyInvite"
            ]
          },
          {
            "id": "chat",
            "title": "3. Open the chat terminal",
            "description": "Press **Ctrl+Alt+;** — a terminal opens. Type a message, press Enter. Incoming messages scroll in like command output.\n[Open Chat](command:rezo.openChat)",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:rezo.openChat"
            ]
          },
          {
            "id": "pin",
            "title": "4. Pin a note to a line",
            "description": "Select some code and press **Ctrl+Alt+Shift+P**. Your note shows up as a review thread on that line for everyone in the room.\n[Set Display Name](command:rezo.setDisplayName)",
            "media": {
              "markdown": "media/walkthrough/pin.md"
            },
            "completionEvents": [
              "onCommand:rezo.pinSelection",
              "onCommand:rezo.setDisplayName"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  }
}
