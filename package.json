{
  "name": "ghostchat",
  "displayName": "GhostChat",
  "description": "Simple LAN chat for VS Code with one-click host and connect setup.",
  "version": "0.0.3",
  "publisher": "GoldMauler",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:ghostchat.quickSetup",
    "onCommand:ghostchat.connectToHost",
    "onCommand:ghostchat.startHostShare",
    "onCommand:ghostchat.listGroups",
    "onCommand:ghostchat.showSharedFilePath"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghostchat.setSharedFilePath",
        "title": "GhostChat: Set Shared File Path"
      },
      {
        "command": "ghostchat.quickSetup",
        "title": "GhostChat: Quick Setup"
      },
      {
        "command": "ghostchat.createGroup",
        "title": "GhostChat: Create New Group"
      },
      {
        "command": "ghostchat.joinGroup",
        "title": "GhostChat: Join Group by ID"
      },
      {
        "command": "ghostchat.showGroupsInLan",
        "title": "GhostChat: Join Group from LAN List"
      },
      {
        "command": "ghostchat.listGroups",
        "title": "GhostChat: List Groups"
      },
      {
        "command": "ghostchat.showSharedFilePath",
        "title": "GhostChat: Show Shared File Path"
      },
      {
        "command": "ghostchat.debugSharedGroups",
        "title": "GhostChat: Debug Shared Groups"
      },
      {
        "command": "ghostchat.refreshGroups",
        "title": "GhostChat: Refresh Groups"
      },
      {
        "command": "ghostchat.dumpSharedFile",
        "title": "GhostChat: Open Shared File (inspect)"
      },
      {
        "command": "ghostchat.deleteGroup",
        "title": "GhostChat: Delete Group"
      },
      {
        "command": "ghostchat.startHostShare",
        "title": "GhostChat: Start Host Share (HTTP)"
      },
      {
        "command": "ghostchat.stopHostShare",
        "title": "GhostChat: Stop Host Share (HTTP)"
      },
      {
        "command": "ghostchat.connectToHost",
        "title": "GhostChat: Connect to Host"
      },
      {
        "command": "ghostchat.disconnectFromHost",
        "title": "GhostChat: Disconnect from Host"
      },
      {
        "command": "ghostchat.setActiveGroup",
        "title": "GhostChat: Set Active Group"
      },
      {
        "command": "ghostchat.showCurrentGroup",
        "title": "GhostChat: Show Current Group"
      },
      {
        "command": "ghostchat.sendMessage",
        "title": "GhostChat: Send Selected Text"
      },
      {
        "command": "ghostchat.insertHistory",
        "title": "GhostChat: Insert Group History"
      },
      {
        "command": "ghostchat.setSenderName",
        "title": "GhostChat: Set Sender Name"
      }
    ],
    "keybindings": [
      {
        "command": "ghostchat.sendMessage",
        "key": "ctrl+shift+s",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "ghostchat.insertHistory",
        "key": "ctrl+shift+v",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://example.com/ghostchat.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.86.0",
    "@types/node": "^18.0.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^4.7.4"
  }
}
