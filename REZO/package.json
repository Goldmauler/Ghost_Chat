{
  "name": "rezo",
  "displayName": "REZO",
  "description": "Send and receive team messages inside your editor files — no sidebar, no panels.",
  "version": "1.0.1",
  "publisher": "VimalHariHar",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "team",
    "chat",
    "collaboration",
    "messaging",
    "firebase"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rezo.createRoom",
        "title": "REZO: Create New Room"
      },
      {
        "command": "rezo.joinRoom",
        "title": "REZO: Join Room by Code"
      },
      {
        "command": "rezo.leaveRoom",
        "title": "REZO: Leave Current Room"
      },
      {
        "command": "rezo.sendMessage",
        "title": "REZO: Send Selected Text"
      },
      {
        "command": "rezo.receiveHistory",
        "title": "REZO: Receive History"
      },
      {
        "command": "rezo.setDisplayName",
        "title": "REZO: Set Display Name"
      }
    ],
    "keybindings": [
      {
        "command": "rezo.sendMessage",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "rezo.receiveHistory",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "REZO",
      "properties": {
        "rezo.firebaseConfig": {
          "type": "object",
          "description": "Your Firebase project configuration. Get this from Firebase Console → Project Settings → Your apps.",
          "properties": {
            "apiKey": {
              "type": "string",
              "description": "Firebase API Key"
            },
            "authDomain": {
              "type": "string",
              "description": "Firebase Auth Domain"
            },
            "databaseURL": {
              "type": "string",
              "description": "Firebase Realtime Database URL (e.g. https://your-project-default-rtdb.firebaseio.com)"
            },
            "projectId": {
              "type": "string",
              "description": "Firebase Project ID"
            },
            "storageBucket": {
              "type": "string",
              "description": "Firebase Storage Bucket"
            },
            "messagingSenderId": {
              "type": "string",
              "description": "Firebase Messaging Sender ID"
            },
            "appId": {
              "type": "string",
              "description": "Firebase App ID"
            }
          },
          "default": {}
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  }
}
